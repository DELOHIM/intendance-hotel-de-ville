APP_NAME="Intendance - Hôtel de Ville de Kinshasa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Kinshasa
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=intendance
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="intendance@hoteldeville.cd"
MAIL_FROM_NAME="${APP_NAME}"

# --- Green API (WhatsApp) ---
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
# Indicatif pays par défaut pour normaliser les numéros (RDC = 243)
WHATSAPP_DEFAULT_COUNTRY_CODE=243

# --- Sauvegarde quotidienne ---
BACKUP_PATH=storage/app/backups
BACKUP_KEEP_DAYS=14
